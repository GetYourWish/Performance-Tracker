{
  "expo": {
    "name": "Performance Tracker",
    "slug": "performance-tracker",
    "version": "1.0.3",
    "scheme": "performance-tracker",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#EEF2FF",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF2FF"
    },
    "android": {
      "package": "com.getyourwish.performancetracker",
      "versionCode": 4,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EEF2FF"
      },
      "allowBackup": false
    },
    "platforms": [
      "android"
    ],
    "plugins": [
      "./plugins/with-gradle-version",
      "./plugins/with-expo-gradle-kotlin",
      "./plugins/with-expo-fs-leak",
      "./plugins/with-agp9-compat",
      "./plugins/with-windows-cmake",
      "./plugins/with-standalone-release",
      "./plugins/with-crash-log"
    ],
    "extra": {
      "schemaVersionSupported": 1
    }
  }
}
